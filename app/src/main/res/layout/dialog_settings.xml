<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Font Size Setting -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Розмір шрифту тексту:"
                android:textColor="#1C1917"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSettingFontSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16 sp"
                android:textColor="#C2410C"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbFontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:max="14"
            android:progress="4" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:background="#E7DFD0" />

        <!-- Transpose Setting -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Транспонування акордів (тональність):"
            android:textColor="#1C1917"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTransposeMinus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♭ -1 півтон"
                android:textColor="#C2410C" />

            <TextView
                android:id="@+id/tvTransposeVal"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0"
                android:textColor="#1C1917"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTransposePlus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♯ +1 півтон"
                android:textColor="#C2410C" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:background="#E7DFD0" />

        <!-- Sound of paper toggle -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchSound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:checked="true"
            android:text="Звук шелесту паперу під час гортання:"
            android:textColor="#1C1917"
            android:textSize="15sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:background="#E7DFD0" />

        <!-- GitHub Server Sync Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌐 Синхронізація пісень із GitHub:"
            android:textColor="#1C1917"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Вкажіть посилання на файл songs.json (Raw URL):"
            android:textColor="#78716C"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etGitHubUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="https://raw.githubusercontent.com/.../songs.json"
            android:padding="8dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSyncNow"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#92400E"
            android:text="🔄 Оновити пісні з GitHub зараз"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
